# Copy to .env and fill in. .env is never committed.

# --- LLM ---
# Kept behind one variable so switching models is a config change, not a refactor.
# Groq replaces Gemini from the Phase 0 plan: Gemini's free tier is as low as
# ~20 requests/day, Groq's is 1,000/day on this model - see CLAUDE.md's stack
# table. Strict structured output (response_format json_schema, strict=true)
# is verified against this exact model; changing GROQ_MODEL should be re-verified
# with one real call before anything depends on it (docs/sources.md's own rule).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Observability / evals (Langfuse Cloud, Phase 2+) ---
# Not used by anything in Phase 1 - the agent is deliberately unmeasured at
# the end of this phase. Present here so Phase 2 is a config change, not a
# new file. Langfuse Cloud's free tier keeps data 30 days; anything that
# needs to outlive that gets written into docs/ as committed evidence.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Storage ---
# Neon Postgres. Auto-suspends after 5 minutes idle, wakes on connection -
# verified in Phase 1 verification 5 that a paused LangGraph run survives
# both the process exiting and this suspend/wake cycle.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Scheduling ---
# Generous on purpose: the register changes slowly and there is no prize for
# polling frequently.
POLL_INTERVAL_HOURS=24
