# Copy to .env and fill in. .env is never committed.

# --- LLM ---
# Kept behind one variable so switching models is a config change, not a refactor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Observability / evals (self-hosted Langfuse) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Storage ---
DATABASE_URL=postgresql://localhost:5432/tilsynsagent

# --- Scheduling ---
# Generous on purpose: free-tier generation quota is low and there is no
# prize for polling frequently.
POLL_INTERVAL_HOURS=24
