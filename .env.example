# Copy to .env and fill in. .env is never committed.

# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Observability / evals (Langfuse Cloud) ---
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Storage ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Scheduling ---
POLL_INTERVAL_HOURS=24

# Langfuse annotation queue name. The free tier caps a project at one
# annotation queue.
TILSYNSAGENT_ANNOTATION_QUEUE=grounded-decisions

# Deep link shown in an alert, pointing at that queue in the Langfuse UI.
# Optional; the alert falls back to naming the queue in words.
LANGFUSE_QUEUE_URL=

# Where fetched plan documents are cached. Defaults to
# ~/.cache/tilsynsagent/documents.
TILSYNSAGENT_DOCUMENT_CACHE=
